{
  "name": "dobra",
  "version": "0.1.0",
  "description": "Atalhos por camadas, ações locais e rastreio visual do teclado.",
  "author": { "name": "Raul del Aguila", "email": "38803643+raulaguila@users.noreply.github.com" },
  "homepage": "https://github.com/raulaguila/key-tracker",
  "repository": { "type": "git", "url": "https://github.com/raulaguila/key-tracker.git" },
  "license": "MIT",
  "main": "app/main.cjs",
  "desktopName": "io.dobra.app.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:input": "node scripts/input-phases-smoke.cjs",
    "test:soak": "node scripts/soak-test.cjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:build": "node scripts/signed-build.cjs",
    "release:manifest": "node scripts/release-manifest.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": { "get-windows": "9.3.0", "uiohook-napi": "1.5.5" },
  "devDependencies": { "electron": "44.9.1", "electron-builder": "26.15.3" },
  "build": {
    "appId": "io.dobra.app",
    "productName": "Dobra",
    "asar": true,
    "npmRebuild": false,
    "icon": "app/assets/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asarUnpack": ["node_modules/uiohook-napi/**/*", "node_modules/node-gyp-build/**/*", "node_modules/get-windows/**/*"],
    "files": ["app/**/*", "package.json", "LICENSE"],
    "directories": { "output": "dist" },
    "linux": { "executableName": "dobra", "target": ["AppImage", "deb"], "category": "Utility", "syncDesktopName": true },
    "deb": { "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "libxt6 | libxt6t64"] },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false },
    "mac": { "target": ["dmg", "zip"], "hardenedRuntime": false, "category": "public.app-category.utilities", "extendInfo": { "NSInputMonitoringUsageDescription": "Mostrar as teclas pressionadas no rastreador visual, somente quando ativado." } }
  },
  "overrides": { "tar": "7.5.22" }
}
