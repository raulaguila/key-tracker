{
  "name": "dobra",
  "version": "0.1.0",
  "description": "Atalhos por camadas, ações locais e rastreio visual do teclado.",
  "author": { "name": "Raul del Aguila", "email": "38803643+raulaguila@users.noreply.github.com" },
  "homepage": "https://github.com/raulaguila/key-tracker",
  "repository": { "type": "git", "url": "https://github.com/raulaguila/key-tracker.git" },
  "license": "MIT",
  "main": "app/main.cjs",
  "desktopName": "io.dobra.app.desktop",
  "scripts": {
    "start": "electron .",
    "native:build": "node scripts/build-native-input.cjs",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:orca": "node scripts/orca-smoke.cjs",
    "test:lifecycle": "node scripts/lifecycle-smoke.cjs",
    "test:input": "node scripts/input-phases-smoke.cjs",
    "test:macros": "node scripts/macro-smoke.cjs",
    "test:wayland": "/usr/bin/python3 -I -B scripts/test-linux-input.py",
    "test:soak": "node scripts/soak-test.cjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:build": "node scripts/signed-build.cjs",
    "release:manifest": "node scripts/release-manifest.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": { "get-windows": "9.3.0", "uiohook-napi": "1.5.5" },
  "devDependencies": { "axe-core": "4.12.1", "electron": "44.9.3", "electron-builder": "26.18.0" },
  "build": {
    "appId": "io.dobra.app",
    "productName": "Dobra",
    "asar": true,
    "npmRebuild": false,
    "beforePack": "build/prepare-native-input.cjs",
    "icon": "app/assets/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asarUnpack": ["node_modules/uiohook-napi/**/*", "node_modules/node-gyp-build/**/*", "node_modules/get-windows/**/*", "app/linux-input/**", "app/native-input/**", "app/macro-input/**"],
    "files": ["app/**/*", "package.json", "LICENSE", "!**/__pycache__/**"],
    "directories": { "output": "dist" },
    "linux": { "executableName": "dobra", "target": ["AppImage", "deb"], "category": "Utility", "syncDesktopName": true },
    "deb": {"depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "libxt6 | libxt6t64", "python3", "python3-gi", "gir1.2-glib-2.0", "libevdev2", "libudev1", "polkitd", "dbus", "systemd"], "fpm": ["--deb-systemd", "artifacts/linux-input-package/dobra-input.service", "--no-deb-systemd-enable", "--no-deb-systemd-auto-start", "artifacts/linux-input-package/service.py=/usr/libexec/dobra-input/service.py", "artifacts/linux-input-package/evdev.py=/usr/libexec/dobra-input/evdev.py", "artifacts/linux-input-package/io.dobra.Input1.service=/usr/share/dbus-1/system-services/io.dobra.Input1.service", "artifacts/linux-input-package/io.dobra.Input1.conf=/usr/share/dbus-1/system.d/io.dobra.Input1.conf", "artifacts/linux-input-package/io.dobra.input.policy=/usr/share/polkit-1/actions/io.dobra.input.policy"]},
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false },
    "mac": { "target": ["dmg", "zip"], "hardenedRuntime": false, "category": "public.app-category.utilities", "extendInfo": { "NSInputMonitoringUsageDescription": "Observar teclas para executar as ações configuradas e mostrar o rastreador visual, após ativação explícita." } }
  },
  "overrides": { "tar": "7.5.22", "global-agent": "4.1.3" }
}
